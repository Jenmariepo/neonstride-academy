{
  "name": "neonstride-academy",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "backend"
  ],
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env backend/server.js",
    "dev": "node --watch --env-file-if-exists=.env backend/server.js",
    "test": "node --test --test-isolation=none tests/*.test.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit:code": "node scripts/audit-code.js",
    "test:browser": "node tests/browser-check.js",
    "check": "npm run lint && npm run audit:code && npm test",
    "build": "node scripts/build-frontend.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "acorn": "^8.15.0",
    "acorn-walk": "^8.3.4",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.6.2"
  }
}
